{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oddments",
  "version": "1.0.2",
  "identifier": "app.perch.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Oddments",
        "width": 1380,
        "height": 880,
        "minWidth": 880,
        "minHeight": 560,
        "dragDropEnabled": false,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0b0c10"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "media-src": "'self' asset: http://asset.localhost blob: https:",
        "font-src": "'self' asset: http://asset.localhost blob: data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data: ws://localhost:1420",
        "frame-src": "https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$DOCUMENT/Oddments Library/**", "$DOCUMENT/Perch Library/**", "$APPLOCALDATA/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5NDMwNTFDQUM4MDQxQjQKUldTMFFZQ3NIQVZEbVpWbkhiUFZvdWR5R0Z0MjhkeGFSUVVMNmN2VVJqNmlFQzBLam5kcnZzODYK",
      "endpoints": ["https://github.com/peopleskynet-boop/Oddments/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "resources/autoremesher/": "autoremesher/", "../LICENSE": "LICENSE.txt", "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Russian", "English"] }
    }
  }
}
