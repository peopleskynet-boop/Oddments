{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "Oddments",
  "version": "1.5.0",
  "description": "__MSG_desc__",
  "minimum_chrome_version": "116",
  "icons": {
    "32": "icon32.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Oddments",
    "default_icon": {
      "32": "icon32.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "i18n.js",
        "content.js",
        "block.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://player.vimeo.com/video/*"
      ],
      "js": [
        "i18n.js",
        "embed.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "shot-visible": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_cmd_shot_visible__"
    },
    "shot-area": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "__MSG_cmd_shot_area__"
    },
    "save-all": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "__MSG_cmd_save_all__"
    },
    "save-article": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "__MSG_cmd_save_article__"
    },
    "grab-block": {
      "description": "__MSG_cmd_grab_block__"
    }
  },
  "default_locale": "en"
}
